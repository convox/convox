apiVersion: v1
kind: ConfigMap
metadata:
  namespace: {{.Namespace}}
  name: resource-{{ k8sname .Name }}
  labels:
    system: convox
    rack: {{.Rack}}
    app: {{.App}}
    type: elasticache-memcached
    resource: {{.Name}}
    provisioner: elasticache
data:
  URL: {{ yamlQuote (printf "memcached://%s:%s" .Host .Port) }}
  USER: ""
  PASS: ""
  HOST: {{ yamlQuote .Host }}
  PORT: {{ yamlQuote .Port }}
  NAME: ""
---
