apiVersion: v1
kind: ConfigMap
metadata:
  namespace: {{.Namespace}}
  name: resource-{{ k8sname .Name }}
  labels:
    system: convox
    rack: {{.Rack}}
    app: {{.App}}
    type: rds-postgres
    resource: {{ k8sname .Name }}
    provisioner: rds
data:
  URL: {{ yamlQuote (printf "postgres://%s:%s@%s:%s/%s?sslmode=disable" .User .Password .Host .Port .Database) }}
  USER: {{ yamlQuote .User }}
  PASS: {{ yamlQuote .Password }}
  HOST: {{ yamlQuote .Host }}
  PORT: {{ yamlQuote .Port }}
  NAME: {{ yamlQuote .Database }}
---
