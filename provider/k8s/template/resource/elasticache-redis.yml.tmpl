apiVersion: v1
kind: ConfigMap
metadata:
  namespace: {{.Namespace}}
  name: resource-{{ k8sname .Name }}
  labels:
    system: convox
    rack: {{.Rack}}
    app: {{.App}}
    type: elasticache-memcached
    resource: {{.Name}}
    provisioner: elasticache
data:
  URL: {{ if .Password }}{{ yamlQuote (printf "rediss://%s@%s:%s/0" .Password .Host .Port) }}{{ else }}{{ yamlQuote (printf "redis://%s:%s/0" .Host .Port) }}{{ end }}
  USER: ""
  PASS: {{ yamlQuote .Password }}
  HOST: {{ yamlQuote .Host }}
  PORT: {{ yamlQuote .Port }}
  NAME: ""
---
