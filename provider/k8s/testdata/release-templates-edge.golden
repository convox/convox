apiVersion: v1
data:
  HOST: resource-db.rack-myapp.svc.cluster.local
  NAME: app
  PASS: abc123
  PORT: "5432"
  URL: postgres://app:abc123@resource-db.rack-myapp.svc.cluster.local:5432/app?sslmode=disable
  USER: app
kind: ConfigMap
metadata:
  labels:
    app: myapp
    provider: k8s
    rack: rack
    release: RABCDEF
    resource: db
    system: convox
    type: resource
  name: resource-db
  namespace: rack-myapp
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  labels:
    app: myapp
    provider: k8s
    rack: rack
    release: RABCDEF
    resource: db
    system: convox
  name: resource-db
  namespace: rack-myapp
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 20Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    atom.conditions: Available=True,Progressing=True/NewReplicaSetAvailable
  labels:
    app: myapp
    kind: postgres
    name: db
    provider: k8s
    rack: rack
    release: RABCDEF
    resource: db
    system: convox
    type: resource
  name: resource-db
  namespace: rack-myapp
spec:
  replicas: 1
  selector:
    matchLabels:
      app: myapp
      rack: rack
      resource: db
      system: convox
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: myapp
        rack: rack
        resource: db
        system: convox
        type: resource
    spec:
      containers:
      - env:
        - name: POSTGRES_DB
          value: app
        - name: POSTGRES_USER
          value: app
        - name: POSTGRES_PASSWORD
          value: abc123
        - name: PGDATA
          value: /var/lib/postgresql/data/data
        image: postgres:13.4
        imagePullPolicy: IfNotPresent
        name: postgres
        ports:
        - containerPort: 5432
        resources:
          limits:
            cpu: 250m
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 512Mi
        volumeMounts:
        - mountPath: /var/lib/postgresql/data
          name: data
      imagePullSecrets:
      - name: docker-hub-authentication
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: resource-db
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    convox.com/alias: resource-db.rack-myapp.svc.cluster.local
  labels:
    app: myapp
    provider: k8s
    rack: rack
    release: RABCDEF
    resource: db
    system: convox
    type: resource
  name: resource-db
  namespace: rack-myapp
spec:
  ports:
  - port: 5432
  selector:
    app: myapp
    rack: rack
    resource: db
    system: convox
  type: NodePort
