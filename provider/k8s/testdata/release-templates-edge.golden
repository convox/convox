---
apiVersion: v1
kind: ServiceAccount
metadata:
  annotations:
    "~": tilde
    "0x1F": hex
    "1": one
    "1.5": float
    bs: C:\path\to
    colon.key: 'a: b'
    empty: ""
    foo bar: space key
    hashval: 'a #b'
    json: '{"k": "v"}'
    keep: |+
      line one
      line two

    'key ': ' value'
    key1: value1
    lead: '  x'
    ls: 'a       b'
    "n": "no"
    nel: "a\Nb"
    nl: |2+

    "null": nothing
    spaces: '  padded  '
    tab: "a\tb"
    "true": "on"
    unicode: héllo wörld
    "yes": "1"
  labels:
    true: "off"
    app.kubernetes.io/name: web
    enabled: "true"
    flag: "yes"
    service: web
    team: platform
    tier: "1"
    type: serviceaccount
    version: "1.0"
  name: web
  namespace: rack-myapp
---
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    atom.conditions: Available=True,Progressing=True/NewReplicaSetAvailable
  labels:
    true: "off"
    app: myapp
    app.kubernetes.io/name: web
    enabled: "true"
    flag: "yes"
    service: web
    team: platform
    tier: "1"
    type: service
    version: "1.0"
  name: web
  namespace: rack-myapp
spec:
  minReadySeconds: 1
  progressDeadlineSeconds: 600
  replicas: 1
  revisionHistoryLimit: 1
  selector:
    matchLabels:
      app: myapp
      rack: rack
      service: web
      system: convox
  strategy:
    rollingUpdate:
      maxSurge: 50%
      maxUnavailable: 0%
    type: RollingUpdate
  template:
    metadata:
      annotations:
        "~": tilde
        "0x1F": hex
        "1": one
        "1.5": float
        bs: C:\path\to
        colon.key: 'a: b'
        empty: ""
        foo bar: space key
        hashval: 'a #b'
        json: '{"k": "v"}'
        keep: |+
          line one
          line two

        'key ': ' value'
        key1: value1
        lead: '  x'
        ls: 'a           b'
        "n": "no"
        nel: "a\Nb"
        nl: |2+

        "null": nothing
        spaces: '  padded  '
        tab: "a\tb"
        "true": "on"
        unicode: héllo wörld
        "yes": "1"
      labels:
        true: "off"
        app: myapp
        app.kubernetes.io/name: web
        enabled: "true"
        flag: "yes"
        name: web
        rack: rack
        release: RABCDEF
        service: web
        system: convox
        team: platform
        tier: "1"
        type: service
        version: "1.0"
    spec:
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - preference:
              matchExpressions:
              - key: node.kubernetes.io/instance-type
                operator: In
                values:
                - m5.large
            weight: 10
          - preference:
              matchExpressions:
              - key: example.com/bool
                operator: In
                values:
                - true
            weight: 1
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: convox.io/label
                operator: In
                values:
                - true
              - key: example.com/block
                operator: In
                values:
                - gpu
              - key: example.com/booln
                operator: In
                values:
                - true
              - key: example.com/hash
                operator: In
                values:
                - x#y
              - key: example.com/null
                operator: In
                values:
                - null
              - key: example.com/num
                operator: In
                values:
                - 123
              - key: example.com/pct
                operator: In
                values:
                - 100%
              - key: example.com/space
                operator: In
                values:
                - a b
              - key: example.com/uni
                operator: In
                values:
                - é
              - key: kubernetes.io/arch
                operator: In
                values:
                - arm64
      containers:
      - args:
        - sh
        - -c
        - echo a && echo b | grep -v c; curl 'http://x/?a=1¶=2&b=<c'
        env:
        - name: INSTANCE_IP
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        - name: DB_URL
          valueFrom:
            configMapKeyRef:
              key: URL
              name: resource-db
        - name: DB_USER
          valueFrom:
            configMapKeyRef:
              key: USER
              name: resource-db
        - name: DB_PASS
          valueFrom:
            configMapKeyRef:
              key: PASS
              name: resource-db
        - name: DB_HOST
          valueFrom:
            configMapKeyRef:
              key: HOST
              name: resource-db
        - name: DB_PORT
          valueFrom:
            configMapKeyRef:
              key: PORT
              name: resource-db
        - name: DB_NAME
          valueFrom:
            configMapKeyRef:
              key: NAME
              name: resource-db
        - name: CACHE_URL
          valueFrom:
            configMapKeyRef:
              key: URL
              name: resource-cache
        envFrom:
        - secretRef:
            name: env-web
        image: repo1:web.BABC
        imagePullPolicy: IfNotPresent
        lifecycle:
          postStart:
            exec:
              command:
              - echo
              - ¶
              - '&'
          preStop:
            exec:
              command:
              - sleep
              - "5"
              - '&&'
              - echo
              - bye
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /live?a=b&c=d
            port: 3000
          initialDelaySeconds: 10
          periodSeconds: 5
          successThreshold: 1
          timeoutSeconds: 5
        name: myapp
        ports:
        - containerPort: 3000
          name: main
        - containerPort: 5000
          name: port-5000
          protocol: UDP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /health?x=1&y=2
            port: 3000
            scheme: HTTP
          initialDelaySeconds: 5
          periodSeconds: 5
          successThreshold: 1
          timeoutSeconds: 4
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 256m
            memory: 512Mi
        securityContext:
          capabilities:
            add:
            - NET_ADMIN
            drop:
            - ALL
          seccompProfile:
            type: RuntimeDefault
        startupProbe:
          failureThreshold: 3
          initialDelaySeconds: 10
          periodSeconds: 5
          successThreshold: 1
          tcpSocket:
            port: 3000
          timeoutSeconds: 5
        volumeMounts:
        - mountPath: /etc/convox
          name: ca
        - mountPath: /etc/my app/app config.json
          name: cfg-cfg1
          subPath: app config.json
        - mountPath: /etc/app/settings.yml
          name: cfg-cfg2
          subPath: settings.yml
        - mountPath: /var/cache dir
          name: ed-cache
        - mountPath: /tmp/a#b
          name: ed-tmp2
        - mountPath: /scratch
          name: ed-scratch
      dnsConfig:
        nameservers:
        - 10.0.0.10
        searches:
        - myapp.rack.local
        - rack-myapp.svc.cluster.local
        - rack.local
        - svc.cluster.local
        - cluster.local
      dnsPolicy: None
      imagePullSecrets:
      - name: docker-hub-authentication
      - name: convox-x-y-pull-a
      - name: convox-registry-authentication
      initContainers:
      - args:
        - sh
        - -c
        - echo init && touch /var/cache\ dir/x
        env:
        - name: INIT_CONTAINER
          value: "true"
        - name: DB_URL
          valueFrom:
            configMapKeyRef:
              key: URL
              name: resource-db
        - name: DB_USER
          valueFrom:
            configMapKeyRef:
              key: USER
              name: resource-db
        - name: DB_PASS
          valueFrom:
            configMapKeyRef:
              key: PASS
              name: resource-db
        - name: DB_HOST
          valueFrom:
            configMapKeyRef:
              key: HOST
              name: resource-db
        - name: DB_PORT
          valueFrom:
            configMapKeyRef:
              key: PORT
              name: resource-db
        - name: DB_NAME
          valueFrom:
            configMapKeyRef:
              key: NAME
              name: resource-db
        - name: CACHE_URL
          valueFrom:
            configMapKeyRef:
              key: URL
              name: resource-cache
        envFrom:
        - secretRef:
            name: env-web
        image: busybox@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
        name: init
        volumeMounts:
        - mountPath: /var/cache dir
          name: ed-cache
        - mountPath: /etc/my app/app config.json
          name: cfg-cfg1
          subPath: app config.json
      serviceAccountName: web
      shareProcessNamespace: true
      terminationGracePeriodSeconds: 30
      tolerations:
      - effect: NoSchedule
        key: dedicated-node
        operator: Equal
        value: "true"
      volumes:
      - configMap:
          name: ca
          optional: true
        name: ca
      - emptyDir:
          medium: Memory
          sizeLimit: 1Gi
        name: ed-cache
      - emptyDir: {}
        name: ed-tmp2
      - emptyDir: {}
        name: ed-scratch
      - name: cfg-cfg1
        secret:
          items:
          - key: app.json
            path: app config.json
          secretName: cfg-cfg1
      - name: cfg-cfg2
        secret:
          items:
          - key: app.json
            path: settings.yml
          secretName: cfg-cfg2
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  labels:
    true: "off"
    app.kubernetes.io/name: web
    enabled: "true"
    flag: "yes"
    service: web
    team: platform
    tier: "1"
    version: "1.0"
  name: web
  namespace: rack-myapp
spec:
  maxReplicas: 3
  metrics:
  - resource:
      name: cpu
      target:
        averageUtilization: 50
        type: Utilization
    type: Resource
  - external:
      metric:
        name: sqs.queue/messages
        selector:
          matchLabels:
            true: true
            queue: my queue
      target:
        averageValue: 30
        type: AverageValue
    type: External
  minReplicas: 1
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: web
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    convox.com/alias: web.myapp.rack.local
  labels:
    true: "off"
    app: myapp
    app.kubernetes.io/name: web
    enabled: "true"
    flag: "yes"
    rack: rack
    service: web
    system: convox
    team: platform
    tier: "1"
    version: "1.0"
  name: web
  namespace: rack-myapp
spec:
  ports:
  - name: main
    port: 3000
    protocol: TCP
    targetPort: main
  - name: port-5000
    port: 5000
    protocol: UDP
    targetPort: 5000
  selector:
    service: web
    type: service
  type: ClusterIP
# app/ingress db
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    alb.ingress.kubernetes.io/scheme: internet-facing
    cert-manager.io/cluster-issuer: letsencrypt
    convox.com/backend-protocol: http
    convox.com/idles: "false"
    nginx.ingress.kubernetes.io/backend-protocol: http
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "60"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "60"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "60"
    nginx.ingress.kubernetes.io/server-snippet: |
      keepalive_timeout 60s;
      client_body_timeout 60s;
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
  labels:
    true: x
    app: myapp
    enabled: "true"
    service: db
    system: convox
    team: platform
    type: service
    version: "1.0"
  name: db
  namespace: rack-myapp
spec:
  ingressClassName: nginx
  rules:
  - host: db.myapp.example.org
    http:
      paths:
      - backend:
          service:
            name: db
            port:
              number: 5432
        pathType: ImplementationSpecific
