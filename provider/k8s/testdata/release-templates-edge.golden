# certificate web
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  labels:
    app: myapp
    service: web
    system: convox
    type: service
  name: cert-web
  namespace: rack-myapp
spec:
  dnsNames:
  - web.myapp.example.org
  duration: 2160h0m0s
  issuerRef:
    group: cert-manager.io
    kind: ClusterIssuer
    name: letsencrypt
  privateKey:
    rotationPolicy: Never
  secretName: cert-web
  secretTemplate:
    labels:
      system: convox
      type: letsencrypt-certificate
  usages:
  - digital signature
  - key encipherment
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  labels:
    app: myapp
    service: web
    system: convox
    type: service
  name: cert-web-domains
  namespace: rack-myapp
spec:
  dnsNames:
  - a.example.com
  - '*.example.com'
  duration: 2160h0m0s
  issuerRef:
    group: cert-manager.io
    kind: ClusterIssuer
    name: letsencrypt
  privateKey:
    rotationPolicy: Never
  secretName: cert-web-domains
  secretTemplate:
    labels:
      system: convox
      type: letsencrypt-certificate
  usages:
  - digital signature
  - key encipherment
