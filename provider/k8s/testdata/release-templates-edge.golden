  labels:
    true: x
    app: myapp
    enabled: "true"
    provider: k8s
    rack: rack
    release: RABCDEF
    service: single
    system: convox
    team: platform
    version: "1.0"
  name: single
  namespace: rack-myapp
spec:
  ports:
  - name: main
    port: 4000
    protocol: TCP
    targetPort: main
  selector:
    service: single
    type: service
  type: ClusterIP
