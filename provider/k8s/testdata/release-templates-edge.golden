apiVersion: apps/v1
kind: StatefulSet
metadata:
  annotations:
    atom.conditions: Ready=True
  labels:
    true: x
    app: myapp
    enabled: "true"
    provider: k8s
    rack: rack
    release: RABCDEF
    service: db
    system: convox
    team: platform
    type: service
    version: "1.0"
  name: db
  namespace: rack-myapp
spec:
  minReadySeconds: 1
  podManagementPolicy: Parallel
  replicas: 1
  revisionHistoryLimit: 1
  selector:
    matchLabels:
      app: myapp
      rack: rack
      service: db
      system: convox
  serviceName: db-headless
  template:
    metadata:
      annotations: null
      labels:
        true: x
        app: myapp
        enabled: "true"
        name: db
        rack: rack
        release: RABCDEF
        service: db
        system: convox
        team: platform
        type: service
        version: "1.0"
    spec:
      containers:
      - env:
        - name: INSTANCE_IP
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        envFrom:
        - secretRef:
            name: env-db
        image: repo1:db.BABC
        imagePullPolicy: IfNotPresent
        name: myapp
        ports:
        - containerPort: 5432
          name: main
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /
            port: 5432
            scheme: HTTP
          initialDelaySeconds: 5
          periodSeconds: 5
          successThreshold: 1
          timeoutSeconds: 4
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 512Mi
        volumeMounts:
        - mountPath: /etc/convox
          name: ca
        - mountPath: /var/lib/data dir
          name: pvc-data
      dnsConfig:
        nameservers:
        - 10.0.0.10
        searches:
        - myapp.rack.local
        - rack-myapp.svc.cluster.local
        - rack.local
        - svc.cluster.local
        - cluster.local
      dnsPolicy: None
      imagePullSecrets:
      - name: docker-hub-authentication
      - name: convox-x-y-pull-a
      - name: convox-registry-authentication
      serviceAccountName: db
      shareProcessNamespace: true
      terminationGracePeriodSeconds: 30
      volumes:
      - configMap:
          name: ca
          optional: true
        name: ca
  updateStrategy:
    type: RollingUpdate
  volumeClaimTemplates:
  - metadata:
      name: pvc-data
    spec:
      accessModes:
      - ReadWriteOnce
      resources:
        requests:
          storage: 10Gi
      storageClassName: gp3
      volumeMode: Filesystem
