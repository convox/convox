# timer cleanup
null
---
apiVersion: v1
kind: ServiceAccount
metadata:
  annotations:
    convox.com/type: timer
    keep: |+
      a

    'key ': ' value'
    nl: |2+

    "null": x
    "true": "on"
  labels:
    timer: cleanup
    type: serviceaccount
  name: timer-cleanup
  namespace: rack-myapp
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: timer-cleanup
  namespace: rack-myapp
spec:
  concurrencyPolicy: forbid
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        metadata:
          annotations:
            convox.com/type: timer
            keep: |+
              a

            'key ': ' value'
            nl: |2+

            "null": x
            "true": "on"
          labels:
            true: "off"
            app: myapp
            app.kubernetes.io/name: web
            enabled: "true"
            flag: "yes"
            name: cleanup
            rack: rack
            release: RABCDEF
            service: web
            system: convox
            team: platform
            tier: "1"
            type: timer
            version: "1.0"
        spec:
          affinity:
            nodeAffinity:
              preferredDuringSchedulingIgnoredDuringExecution:
              - preference:
                  matchExpressions:
                  - key: node.kubernetes.io/instance-type
                    operator: In
                    values:
                    - m5.large
                weight: 10
              - preference:
                  matchExpressions:
                  - key: example.com/bool
                    operator: In
                    values:
                    - true
                weight: 1
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                - matchExpressions:
                  - key: convox.io/label
                    operator: In
                    values:
                    - true
                  - key: example.com/block
                    operator: In
                    values:
                    - gpu
                  - key: example.com/booln
                    operator: In
                    values:
                    - true
                  - key: example.com/hash
                    operator: In
                    values:
                    - x#y
                  - key: example.com/null
                    operator: In
                    values:
                    - null
                  - key: example.com/num
                    operator: In
                    values:
                    - 123
                  - key: example.com/pct
                    operator: In
                    values:
                    - 100%
                  - key: example.com/space
                    operator: In
                    values:
                    - a b
                  - key: example.com/uni
                    operator: In
                    values:
                    - é
                  - key: kubernetes.io/arch
                    operator: In
                    values:
                    - arm64
          containers:
          - args:
            - bin/cleanup
            - --since
            - 1 day
            - '&&'
            - echo
            - '&'
            env:
            - name: INSTANCE_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.hostIP
            - name: DB_URL
              valueFrom:
                configMapKeyRef:
                  key: URL
                  name: resource-db
            - name: DB_USER
              valueFrom:
                configMapKeyRef:
                  key: USER
                  name: resource-db
            - name: DB_PASS
              valueFrom:
                configMapKeyRef:
                  key: PASS
                  name: resource-db
            - name: DB_HOST
              valueFrom:
                configMapKeyRef:
                  key: HOST
                  name: resource-db
            - name: DB_PORT
              valueFrom:
                configMapKeyRef:
                  key: PORT
                  name: resource-db
            - name: DB_NAME
              valueFrom:
                configMapKeyRef:
                  key: NAME
                  name: resource-db
            - name: CACHE_URL
              valueFrom:
                configMapKeyRef:
                  key: URL
                  name: resource-cache
            envFrom:
            - secretRef:
                name: env-web
            image: repo1:web.BABC
            imagePullPolicy: IfNotPresent
            name: myapp
            resources:
              limits:
                memory: 512Mi
              requests:
                cpu: 256m
                memory: 512Mi
            securityContext:
              capabilities:
                add:
                - NET_ADMIN
                drop:
                - ALL
              seccompProfile:
                type: RuntimeDefault
            volumeMounts:
            - mountPath: /etc/convox
              name: ca
            - mountPath: /etc/my app/app config.json
              name: cfg-cfg1
              subPath: app config.json
            - mountPath: /etc/app/settings.yml
              name: cfg-cfg2
              subPath: settings.yml
            - mountPath: /var/cache dir
              name: ed-cache
            - mountPath: /tmp/a#b
              name: ed-tmp2
            - mountPath: /scratch
              name: ed-scratch
          dnsConfig:
            nameservers:
            - 10.0.0.10
            searches:
            - myapp.rack.local
            - rack-myapp.svc.cluster.local
            - rack.local
            - svc.cluster.local
            - cluster.local
          dnsPolicy: None
          imagePullSecrets:
          - name: docker-hub-authentication
          - name: x
          restartPolicy: Never
          serviceAccountName: timer-cleanup
          shareProcessNamespace: true
          terminationGracePeriodSeconds: 30
          tolerations:
          - effect: NoSchedule
            key: dedicated-node
            operator: Equal
            value: "true"
          volumes:
          - configMap:
              name: ca
              optional: true
            name: ca
          - emptyDir:
              medium: Memory
              sizeLimit: 1Gi
            name: ed-cache
          - emptyDir: {}
            name: ed-tmp2
          - emptyDir: {}
            name: ed-scratch
          - name: cfg-cfg1
            secret:
              items:
              - key: app.json
                path: app config.json
              secretName: cfg-cfg1
          - name: cfg-cfg2
            secret:
              items:
              - key: app.json
                path: settings.yml
              secretName: cfg-cfg2
  schedule: '*/5 * * * *'
  successfulJobsHistoryLimit: 1
# timer daily
null
---
apiVersion: v1
kind: ServiceAccount
metadata:
  annotations:
    convox.com/type: timer
  labels:
    timer: daily
    type: serviceaccount
  name: timer-daily
  namespace: rack-myapp
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: timer-daily
  namespace: rack-myapp
spec:
  concurrencyPolicy: null
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        metadata:
          annotations:
            convox.com/type: timer
          labels:
            true: "off"
            app: myapp
            app.kubernetes.io/name: web
            enabled: "true"
            flag: "yes"
            name: daily
            rack: rack
            release: RABCDEF
            service: web
            system: convox
            team: platform
            tier: "1"
            type: timer
            version: "1.0"
        spec:
          affinity:
            nodeAffinity:
              preferredDuringSchedulingIgnoredDuringExecution:
              - preference:
                  matchExpressions:
                  - key: node.kubernetes.io/instance-type
                    operator: In
                    values:
                    - m5.large
                weight: 10
              - preference:
                  matchExpressions:
                  - key: example.com/bool
                    operator: In
                    values:
                    - true
                weight: 1
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                - matchExpressions:
                  - key: convox.io/label
                    operator: In
                    values:
                    - true
                  - key: example.com/block
                    operator: In
                    values:
                    - gpu
                  - key: example.com/booln
                    operator: In
                    values:
                    - true
                  - key: example.com/hash
                    operator: In
                    values:
                    - x#y
                  - key: example.com/null
                    operator: In
                    values:
                    - null
                  - key: example.com/num
                    operator: In
                    values:
                    - 123
                  - key: example.com/pct
                    operator: In
                    values:
                    - 100%
                  - key: example.com/space
                    operator: In
                    values:
                    - a b
                  - key: example.com/uni
                    operator: In
                    values:
                    - é
                  - key: kubernetes.io/arch
                    operator: In
                    values:
                    - arm64
          containers:
          - args:
            - bin/daily
            env:
            - name: INSTANCE_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.hostIP
            - name: DB_URL
              valueFrom:
                configMapKeyRef:
                  key: URL
                  name: resource-db
            - name: DB_USER
              valueFrom:
                configMapKeyRef:
                  key: USER
                  name: resource-db
            - name: DB_PASS
              valueFrom:
                configMapKeyRef:
                  key: PASS
                  name: resource-db
            - name: DB_HOST
              valueFrom:
                configMapKeyRef:
                  key: HOST
                  name: resource-db
            - name: DB_PORT
              valueFrom:
                configMapKeyRef:
                  key: PORT
                  name: resource-db
            - name: DB_NAME
              valueFrom:
                configMapKeyRef:
                  key: NAME
                  name: resource-db
            - name: CACHE_URL
              valueFrom:
                configMapKeyRef:
                  key: URL
                  name: resource-cache
            envFrom:
            - secretRef:
                name: env-web
            image: repo1:web.BABC
            imagePullPolicy: IfNotPresent
            name: myapp
            resources:
              limits:
                memory: 512Mi
              requests:
                cpu: 256m
                memory: 512Mi
            securityContext:
              capabilities:
                add:
                - NET_ADMIN
                drop:
                - ALL
              seccompProfile:
                type: RuntimeDefault
            volumeMounts:
            - mountPath: /etc/convox
              name: ca
            - mountPath: /etc/my app/app config.json
              name: cfg-cfg1
              subPath: app config.json
            - mountPath: /etc/app/settings.yml
              name: cfg-cfg2
              subPath: settings.yml
            - mountPath: /var/cache dir
              name: ed-cache
            - mountPath: /tmp/a#b
              name: ed-tmp2
            - mountPath: /scratch
              name: ed-scratch
          dnsConfig:
            nameservers:
            - 10.0.0.10
            searches:
            - myapp.rack.local
            - rack-myapp.svc.cluster.local
            - rack.local
            - svc.cluster.local
            - cluster.local
          dnsPolicy: None
          imagePullSecrets:
          - name: docker-hub-authentication
          - name: x
          restartPolicy: Never
          serviceAccountName: timer-daily
          shareProcessNamespace: true
          terminationGracePeriodSeconds: 30
          tolerations:
          - effect: NoSchedule
            key: dedicated-node
            operator: Equal
            value: "true"
          volumes:
          - configMap:
              name: ca
              optional: true
            name: ca
          - emptyDir:
              medium: Memory
              sizeLimit: 1Gi
            name: ed-cache
          - emptyDir: {}
            name: ed-tmp2
          - emptyDir: {}
            name: ed-scratch
          - name: cfg-cfg1
            secret:
              items:
              - key: app.json
                path: app config.json
              secretName: cfg-cfg1
          - name: cfg-cfg2
            secret:
              items:
              - key: app.json
                path: settings.yml
              secretName: cfg-cfg2
  schedule: 0 3 * * *
  successfulJobsHistoryLimit: 1
# resource db
apiVersion: v1
data:
  HOST: resource-db.rack-myapp.svc.cluster.local
  NAME: app
  PASS: abc123
  PORT: "5432"
  URL: postgres://app:abc123@resource-db.rack-myapp.svc.cluster.local:5432/app?sslmode=disable
  USER: app
kind: ConfigMap
metadata:
  labels:
    app: myapp
    rack: rack
    resource: db
    system: convox
    type: resource
  name: resource-db
  namespace: rack-myapp
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  labels:
    app: myapp
    rack: rack
    resource: db
    system: convox
  name: resource-db
  namespace: rack-myapp
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: 20Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    atom.conditions: Available=True,Progressing=True/NewReplicaSetAvailable
  labels:
    app: myapp
    kind: postgres
    name: db
    rack: rack
    resource: db
    system: convox
    type: resource
  name: resource-db
  namespace: rack-myapp
spec:
  replicas: 1
  selector:
    matchLabels:
      app: myapp
      rack: rack
      resource: db
      system: convox
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: myapp
        rack: rack
        resource: db
        system: convox
        type: resource
    spec:
      containers:
      - env:
        - name: POSTGRES_DB
          value: app
        - name: POSTGRES_USER
          value: app
        - name: POSTGRES_PASSWORD
          value: abc123
        - name: PGDATA
          value: /var/lib/postgresql/data/data
        image: postgres:13.4
        imagePullPolicy: IfNotPresent
        name: postgres
        ports:
        - containerPort: 5432
        resources:
          limits:
            cpu: 250m
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 512Mi
        volumeMounts:
        - mountPath: /var/lib/postgresql/data
          name: data
      imagePullSecrets:
      - name: docker-hub-authentication
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: resource-db
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    convox.com/alias: resource-db.rack-myapp.svc.cluster.local
  labels:
    app: myapp
    rack: rack
    resource: db
    system: convox
    type: resource
  name: resource-db
  namespace: rack-myapp
spec:
  ports:
  - port: 5432
  selector:
    app: myapp
    rack: rack
    resource: db
    system: convox
  type: NodePort
