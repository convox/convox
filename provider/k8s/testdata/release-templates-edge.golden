          value: app
        - name: MYSQL_ROOT_PASSWORD
          value: abc123
        image: mysql:5.7.23
        imagePullPolicy: IfNotPresent
        name: mysql
        ports:
        - containerPort: 3306
        resources:
          limits: null
          requests: null
        volumeMounts:
        - mountPath: /var/lib/mysql
          name: data
          subPath: mysql
      imagePullSecrets:
      - name: docker-hub-authentication
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: resource-db
