# app
apiVersion: v1
kind: Namespace
metadata:
  annotations:
    convox.com/lock: "false"
    convox.com/params: '{"Bar":"x\"y","Foo":"a\u0026b"}'
  labels:
    name: myapp
    pod-security.kubernetes.io/enforce: baseline
    type: app
  name: rack-myapp
  ownerReferences:
  - apiVersion: v1
    blockOwnerDeletion: true
    controller: true
    kind: Namespace
    name: rack
    uid: uid1
# ca
apiVersion: v1
binaryData:
  ca.crt: Y2E=
kind: ConfigMap
metadata:
  name: ca
  namespace: rack-myapp
# balancer edgebal
apiVersion: v1
kind: Service
metadata:
  annotations:
    true: "yes"
    service.beta.kubernetes.io/aws-load-balancer-additional-resource-tags: Team=platform,Env=prod
    service.beta.kubernetes.io/aws-load-balancer-attributes: load_balancing.cross_zone.enabled=true
    service.beta.kubernetes.io/aws-load-balancer-connection-idle-timeout: "3600"
    service.beta.kubernetes.io/aws-load-balancer-type: nlb
    x.example.com/amp: a&b&amp;c
    x.example.com/json: '{"a": "b", "c": [1, 2]}'
    x.example.com/quoted: a "quoted" value
  labels:
    true: x
    balancer: edgebal
    enabled: "true"
    service: web
    team: platform
    type: balancer
    version: "1.0"
  name: balancer-edgebal
  namespace: rack-myapp
spec:
  externalTrafficPolicy: Cluster
  loadBalancerSourceRanges:
  - 10.0.0.0/8
  - 192.168.0.0/16
  ports:
  - name: "3000"
    port: 3000
    protocol: TCP
    targetPort: 3000
  - name: "5000"
    port: 5000
    protocol: UDP
    targetPort: 5000
  selector:
    service: web
    type: service
  type: LoadBalancer
# app/ingress web
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  annotations:
    true: "1"
    alb.ingress.kubernetes.io/scheme: internet-facing
    cert-manager.io/cluster-issuer: letsencrypt
    convox.com/backend-protocol: http
    convox.com/idles: "false"
    key: ' value'
    nginx.ingress.kubernetes.io/affinity: cookie
    nginx.ingress.kubernetes.io/backend-protocol: http
    nginx.ingress.kubernetes.io/configuration-snippet: |
      more_set_headers "X-A: b";
      more_set_headers "X-C: d";
    nginx.ingress.kubernetes.io/proxy-connect-timeout: "120"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "120"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "120"
    nginx.ingress.kubernetes.io/server-snippet: |
      keepalive_timeout 120s;
      client_body_timeout 120s;
    nginx.ingress.kubernetes.io/session-cookie-name: CONVOXSESSION
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/whitelist-source-range: 10.0.0.0/8,192.168.0.0/16
    x.example.com/amp: a&b
    x.example.com/att: AT&T
    x.example.com/bs: a\b
    x.example.com/copy: ©
    x.example.com/ent: '&'
    x.example.com/para: ?a=1¶=2
    x.example.com/quote: say "hi"
    x.example.com/region: ?a=1®ion=us
  labels:
    true: "off"
    app: myapp
    app.kubernetes.io/name: web
    enabled: "true"
    flag: "yes"
    service: web
    system: convox
    team: platform
    tier: "1"
    type: service
    version: "1.0"
  name: web
  namespace: rack-myapp
spec:
  ingressClassName: nginx
  rules:
  - host: web.myapp.example.org
    http:
      paths:
      - backend:
          service:
            name: web
            port:
              number: 3000
        pathType: ImplementationSpecific
  - host: a.example.com
    http:
      paths:
      - backend:
          service:
            name: web
            port:
              number: 3000
        pathType: ImplementationSpecific
  - host: '*.example.com'
    http:
      paths:
      - backend:
          service:
            name: web
            port:
              number: 3000
        pathType: ImplementationSpecific
  tls:
  - hosts:
    - a.example.com
    - '*.example.com'
    secretName: cert-web-domains
