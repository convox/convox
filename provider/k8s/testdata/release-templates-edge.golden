# httpproxy web
apiVersion: projectcontour.io/v1
kind: HTTPProxy
metadata:
  annotations:
    true: "1"
    convox.com/backend-protocol: http
    convox.com/idles: "false"
    key: ' value'
    x.example.com/amp: a&b
    x.example.com/att: AT&T
    x.example.com/bs: a\b
    x.example.com/copy: ©
    x.example.com/ent: '&'
    x.example.com/para: ?a=1¶=2
    x.example.com/quote: say "hi"
    x.example.com/region: ?a=1®ion=us
  labels:
    true: "off"
    app: myapp
    app.kubernetes.io/name: web
    enabled: "true"
    flag: "yes"
    service: web
    system: convox
    team: platform
    tier: "1"
    type: service
    version: "1.0"
  name: web
  namespace: rack-myapp
spec:
  ingressClassName: contour
  routes:
  - conditions:
    - prefix: /
    enableWebsockets: true
    loadBalancerPolicy:
      strategy: Cookie
    services:
    - name: web
      port: 3000
    timeoutPolicy:
      idle: 120s
      response: infinity
  virtualhost:
    fqdn: web.myapp.example.org
    ipAllowPolicy:
    - cidr: 10.0.0.0/8
      source: Remote
    - cidr: 192.168.0.0/16
      source: Remote
    tls:
      secretName: my-cert
