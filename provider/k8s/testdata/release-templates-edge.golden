    resource: db2
    system: convox
    type: resource
  name: resource-db
  namespace: rack-myapp
spec:
  replicas: 1
  selector:
    matchLabels:
      app: myapp
      rack: rack
      resource: db2
      system: convox
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: myapp
        rack: rack
        resource: db2
        system: convox
        type: resource
    spec:
      containers:
      - env:
        - name: MYSQL_DATABASE
          value: app
        - name: MYSQL_ROOT_PASSWORD
          value: abc123
        image: mysql:5.7.23
        imagePullPolicy: IfNotPresent
        name: mysql
        ports:
        - containerPort: 3306
        resources:
          limits: null
          requests: null
        volumeMounts:
        - mountPath: /var/lib/mysql
          name: data
          subPath: mysql
      imagePullSecrets:
      - name: docker-hub-authentication
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: resource-db
---
